# GroupPick Environment Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (leave empty or default to auto-start in-memory Mongo if local mongod is absent)
MONGODB_URI=mongodb://127.0.0.1:27017/grouppick

# JWT Secret for organizer authentication
JWT_SECRET=grouppick_super_secret_jwt_dev_key_replace_in_prod

# Client origin for CORS and Socket.io
CLIENT_URL=http://localhost:5173
